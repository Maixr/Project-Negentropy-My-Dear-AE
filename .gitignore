# ============================================================
#  默认忽略一切，只放行「整合包源码」
#  访客 clone 后按 README 用 packwiz-installer 装包
# ============================================================

/*

# ─────────── Packwiz 元数据 ───────────
!/pack.toml
!/index.toml
!/.packwizignore
!/mods/

# ─────────── 整合包内容 ───────────
!/kubejs/
!/config/
!/defaultconfigs/
!/modpack-docs/

# ─────────── 文档 ───────────
!/.gitignore
!/.gitattributes
!/README.md
!/DEVELOPMENT.md
!/CHANGELOG.md
!/LICENSE
!/modlist.md
!/docs/
!/scripts/
!/.github/

# ─────────── mods/ 细则 ───────────
# 只跟踪 packwiz 元数据（.pw.toml）
/mods/*.jar
# 例外：本仓库自有的模组（作者 Maixr）
!/mods/MaixrCore-*.jar
!/mods/entropy_tech-*.jar
!/mods/JEIGuess-*.jar
!/mods/skilled_craftsmaid-*.jar
!/mods/MaixrsPhotoChat-*.jar

# ─────────── config 内的排除 ───────────
# 密钥/密码：绝不入库
/config/ae2webintegration/ae2webintegration.toml
# 大型媒体（超 GitHub 单文件限制）
*.mp4
*.mov
# 备份/临时/已删除
*.bak
*.bak_*
*.bak-*
*.disabled
**/_deleted-*/
**/_backup-*/
**/assets.bak-*/
*.removed-mod
# 单机会话数据
/config/inventoryprofilesnext/*/
/config/jei/world/
/config/ae2_recent_search*
